# Beta w Connect IQ Store ma własny identyfikator — sklep nie zamieni bety w aplikację publiczną,
# a ten sam identyfikator dla obu odrzuca. Ten plik zastępuje monkey.jungle przy ./build.sh beta,
# które wpisuje identyfikator bety w kopię manifestu (manifest-beta.xml, poza gitem).
project.manifest = manifest-beta.xml
base.sourcePath = source
