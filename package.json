{
  "name": "gym-tracker",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "GYM TRACKER — trening siłowy z automatyczną progresją, planem i osiągnięciami",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.demo.json",
    "test": "vitest run",
    "lint": "oxlint",
    "food:taxonomies": "tsx scripts/food/fetch-taxonomies.ts",
    "food:prices": "tsx scripts/food/fetch-prices.ts",
    "food:prepare": "tsx scripts/food/prepare-data.ts",
    "food:data": "npm run food:taxonomies && npm run food:prices && npm run food:prepare",
    "food:extract-priced": "tsx scripts/food/extract-priced.ts",
    "food:check-recipes": "tsx scripts/food/check-recipes.ts",
    "food:check-prep": "tsx scripts/food/check-prep.ts",
    "food:selgros": "tsx scripts/food/fetch-selgros.ts",
    "food:osm": "tsx scripts/food/osm-places.ts",
    "demo:seed": "TZ=Europe/Warsaw vitest run --config scripts/demo-videos/seed/vitest.config.ts",
    "demo:videos": "tsx scripts/demo-videos/record.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "barcode-detector": "3.2.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
