<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Zwykły motyw Material z systemu: bez AppCompat i Material Components aplikacja jest mała. -->
    <style name="Theme.Zdrowie" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Zdrowie.Title" parent="android:TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Zdrowie.Heading" parent="android:TextAppearance.Material.Title">
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="Zdrowie.Body" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Zdrowie.Note" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Zdrowie.Button" parent="android:Widget.Material.Button.Colored">
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="Zdrowie.Button.Plain" parent="android:Widget.Material.Button.Borderless.Colored" />
</resources>
