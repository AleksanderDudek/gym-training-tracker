<?xml version="1.0" encoding="utf-8"?>
<!-- Nic nie idzie do kopii w chmurze ani na nowy telefon: w ustawieniach leży klucz do danych
     o zdrowiu. allowBackup="false" nie wyłącza przenoszenia między telefonami od Androida 12,
     dlatego te reguły. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
