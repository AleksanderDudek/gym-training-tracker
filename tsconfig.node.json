{
  // Kod, który biegnie w node: konfiguracja Vite, jej wtyczki (`vite/`) i skrypty przygotowania
  // danych (`scripts/`, uruchamiane przez `tsx`).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `vite.config.ts` importuje wtyczki z `.ts` na końcu — patrz komentarz przy tych importach.
    // Wolno, bo nic stąd nie jest emitowane (`noEmit`).
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vite", "scripts", "src/vite-env.d.ts"],
  // Filmy demo mają własny `tsconfig.demo.json` (z typami DOM).
  "exclude": ["scripts/demo-videos"]
}
